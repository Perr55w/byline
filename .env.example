# Byline settings. Copy this file to .env (same folder as server.js) and fill in what you use.
# Uncomment a line (remove the leading #) and add its value: KEY=value, no spaces around "=", no quotes
# (the Windows launcher would keep them).
# Everything is optional; blank lines and lines starting with # are ignored. Never commit .env.

# ---- server ----
# Port Byline listens on (deploy scripts default to 3000; `npm start` alone uses 4317)
#PORT=
# Address to listen on. Keep 127.0.0.1 and use `tailscale serve` for the phone; 0.0.0.0 exposes it to your network.
#HOST=
# Where byline.db and media/ live (default: ./data)
#BYLINE_DATA_DIR=

# ---- sign-in (required before any access from another device) ----
# A long passphrase without spaces. Without it Byline refuses every request that is not from this computer.
#BYLINE_PASSWORD=
# Optional: base32 TOTP secret for two-step sign-in (or enroll in Settings > Security instead)
#BYLINE_TOTP_SECRET=
# 1 = ask for the code even on this computer (default: only for remote sign-ins)
#BYLINE_TOTP_ALWAYS=

# ---- the address you open Byline at ----
# Your HTTPS link, e.g. the one `tailscale serve` gives you: https://<pc-name>.<tailnet>.ts.net
# Used for links in notifications and emails, and trusted by the cross-site request check.
#BYLINE_PUBLIC_URL=
# More origins allowed to make changes (comma-separated), if you reach Byline at other addresses too
#BYLINE_ALLOWED_ORIGINS=

# ---- limits ----
# Largest request body in MB (default 25; uploads are sent base64-encoded)
#BYLINE_MAX_BODY_MB=
# Requests per minute per remote address (default 600; a fifth of that for changes)
#BYLINE_RATE_LIMIT=

# ---- backups ----
# Folder for the daily backup (default: ./backups, or <BYLINE_DATA_DIR>/backups when that is set)
# Point it at a OneDrive / Google Drive folder for an off-machine copy.
#BYLINE_BACKUP_DIR=
# How many daily backups to keep (default 7)
#BYLINE_BACKUP_KEEP=
# 0 = no automatic daily backup
#BYLINE_BACKUPS=

# ---- morning digest on your phone (free) ----
# A hard-to-guess ntfy topic; subscribe to the same topic in the ntfy app, then turn on push in Settings
#NTFY_TOPIC=

# ---- email (free Gmail app password) ----
#SMTP_USER=
#SMTP_PASS=
# Defaults: smtp.gmail.com, 465, secure, from = SMTP_USER
#SMTP_HOST=
#SMTP_PORT=
#SMTP_SECURE=
#SMTP_FROM=
# Alternative to Gmail: Resend (free tier)
#RESEND_API_KEY=
#RESEND_FROM=

# ---- local AI (free) ----
# Where Ollama runs (default http://127.0.0.1:11434)
#OLLAMA_HOST=
# Kokoro voice for the audio brief (default af_heart)
#BYLINE_TTS_VOICE=

# ---- paid / v2: leave empty for $0 ----
# Claude API key (paid). Byline stays on free local templates while this is empty.
#ANTHROPIC_API_KEY=
# LinkedIn text-post API (needs your own LinkedIn developer app; token expires every 60 days)
#LINKEDIN_ACCESS_TOKEN=
#LINKEDIN_AUTHOR_URN=
#LINKEDIN_VERSION=
# X API (paid tier)
#X_BEARER_TOKEN=

# ---- networks with an outbound proxy only ----
# 1 = send outbound requests through HTTPS_PROXY / HTTP_PROXY
#NODE_USE_ENV_PROXY=
#HTTPS_PROXY=
#HTTP_PROXY=
